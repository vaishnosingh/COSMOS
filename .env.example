# ==============================================================================
# COSMOS WORKSTATION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=8080
COSMOS_DOMAIN=localhost
COSMOS_BASE_URL=http://localhost:8080
COSMOS_PUBLIC_ENDPOINT=localhost:9000

# ScyllaDB / Cassandra Configuration
SCYLLA_HOST=127.0.0.1
SCYLLA_KEYSPACE=cosmos

# MinIO S3 Object Storage Credentials
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123

# Email / Notification Configuration
# Transactional emails use msmtp or sendmail CLI
COSMOS_EMAIL_FROM=noreply@example.com
COSMOS_ADMIN_EMAIL=admin@example.com

# Gitea Internal Integration
GITEA_URL=http://127.0.0.1:3000
